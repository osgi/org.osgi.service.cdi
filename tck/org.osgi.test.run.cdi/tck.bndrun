	org.apache.geronimo.specs.geronimo-jcdi_2.0_spec;version='${tck.range;${geronimo-jcdi_2.0_spec.version}}',\
	org.apache.servicemix.bundles.junit;version='${tck.range;${servicemix-junit.version}}',\
	org.awaitility;version='${tck.range;${awaitility.version}}',\
	org.hamcrest;version='${tck.range;${hamcrest.version}}',\
	org.jboss.logging.jboss-logging;version='${tck.range;${jboss-logging.version}}',\
	org.jboss.spec.javax.ejb.jboss-ejb-api_3.2_spec;version='${tck.range;${jboss-ejb-api_3.2_spec.version}}',\
